      "html": "<svg class=\"ds-twill\" viewBox=\"0 0 92 112\" role=\"img\" aria-label=\"2\" width=\"92\" height=\"112\"><text class=\"ds-tw-under\" x=\"46\" y=\"104\" font-size=\"140\">2</text><text class=\"ds-tw-top\" x=\"46\" y=\"104\" font-size=\"140\">2</text><text class=\"ds-tw-stitch\" x=\"46\" y=\"104\" font-size=\"140\">2</text></svg>",
      "css": ".ds-twill{overflow:visible;--tw-under:#7a3cff;--tw-top:#fff;--tw-stitch:#0b0b0f}.ds-twill text{font-family:'Poppins',system-ui,sans-serif;font-weight:800;text-anchor:middle}.ds-tw-under{fill:var(--tw-under);stroke:var(--tw-under);stroke-width:7;stroke-linejoin:round;paint-order:stroke;transform:translate(2.5px,3.5px)}.ds-tw-top{fill:var(--tw-top)}.ds-tw-stitch{fill:none;stroke:var(--tw-stitch);stroke-width:1.3;stroke-dasharray:3.2 3;stroke-linejoin:round}"
