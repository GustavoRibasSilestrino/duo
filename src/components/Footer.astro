---
import Wordmark from './Wordmark.astro';
import Icon from './Icon.astro';
import { instagramUrl, site } from '../config/site';

const ig = instagramUrl();
const links = [
  { href: '#pecas', label: 'Peças' },
  { href: '#monte', label: 'Monte a sua' },
  { href: '#como-funciona', label: 'Como funciona' },
  { href: '#quem-faz', label: 'Quem faz' },
  { href: '#pedido', label: 'Pedir' },
];
---

<footer class="foot ground-ink">
  <div class="container foot__grid">
    <div class="foot__brand">
      <Wordmark variant="reversed" class="foot__logo" label="DUO Personalizados" />
      <p class="foot__slogan">
        <span>2 corações,</span> <span>2 objetivos,</span> <span>1 propósito.</span>
      </p>
    </div>

    <nav class="foot__nav" aria-label="Rodapé">
      <ul>
        {links.map((l) => (
          <li><a href={l.href}>{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="foot__contact">
      <a class="btn btn--primary" href="#pedido" data-wa-link>
        <Icon name="chat" />
        <span>Pedir no WhatsApp</span>
      </a>
      {ig && (
        <a class="foot__ig" href={ig} rel="noopener" target="_blank">
          <Icon name="instagram" />
          <span>@{site.instagram.replace(/^@/, '')}</span>
        </a>
      )}
    </div>
  </div>

  <div class="container foot__base">
    <p>© {site.year} {site.name}. Feito por duas pessoas e dois corações.</p>
    <a href="#topo">Voltar ao topo</a>
  </div>
</footer>

<style>
  .foot {
    padding-block: clamp(3rem, 6vw, 5rem) 2rem;
    border-top: 1.5px dashed var(--line-dark);
  }
  .foot__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 3fr) minmax(0, 4fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: start;
  }
  .foot :global(.foot__logo) {
    height: clamp(3.4rem, 6vw, 4.6rem);
    width: auto;
    margin-bottom: 1rem;
  }
  .foot__slogan {
    font: 700 clamp(1.15rem, 0.9rem + 1.2vw, 1.7rem) / 1.2 var(--f-display);
    letter-spacing: -0.02em;
    color: #fff;
    text-wrap: balance;
  }
  .foot__slogan span {
    white-space: nowrap;
  }
  .foot__nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.1rem;
  }
  .foot__nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font: 600 1rem/1 var(--f-display);
    letter-spacing: -0.005em;
    text-decoration: none;
    color: var(--on-dark);
  }
  .foot__nav a:hover {
    color: #fff;
    text-decoration: underline dashed;
    text-decoration-color: var(--purple-hi);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.35em;
  }
  .foot__contact {
    display: grid;
    gap: 1rem;
    justify-items: start;
  }
  .foot__ig {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 2.75rem;
    font-weight: 700;
    color: #fff;
  }
  .foot__ig :global(svg) {
    width: 1.4rem;
    height: 1.4rem;
  }
  .foot__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: 1.25rem;
    border-top: 1.5px dashed var(--line-dark);
    font-size: 0.95rem;
    color: var(--on-dark-soft);
  }
  .foot__base a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--on-dark);
  }

  @media (max-width: 52rem) {
    .foot__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .foot {
      padding-bottom: 6rem;
    }
  }
</style>
