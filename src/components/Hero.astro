---
import Twill from './Twill.astro';
import Piece from './Piece.astro';
import Icon from './Icon.astro';
import { products } from '../config/site';

const kinds = ['camiseta', 'ecobag', 'bolsa', 'copo'] as const;
const colors = [
  { key: 'preta', label: 'Preta', dot: '#2b2638' },
  { key: 'branca', label: 'Branca', dot: '#f4f2fb' },
  { key: 'roxa', label: 'Roxa', dot: '#7a3cff' },
];
const heart = 'M0 62C-60 20-78-20-52-46-30-66-6-56 0-34 6-56 30-66 52-46 78-20 60 20 0 62Z';
---

<section class="hero ground-ink" id="topo" aria-labelledby="hero-title" data-preview data-hero>
  <div class="hero__mesh" aria-hidden="true"></div>

  <div class="container hero__grid">
    <div class="hero__copy">
      <h1 class="hero__title" id="hero-title">
        <span class="sr-only">2 corações, 2 objetivos, 1 propósito</span>
        <span class="slogan" aria-hidden="true">
          <span class="slogan__line">
            <span class="slogan__in">
              <Twill class="slogan__num" text="2" tone="dark" enter delay="0.05s" countTo="2" />
              <span class="slogan__word">corações,</span>
            </span>
          </span>
          <span class="slogan__line">
            <span class="slogan__in">
              <Twill class="slogan__num" text="2" tone="dark" enter delay="0.2s" countTo="2" />
              <span class="slogan__word">objetivos,</span>
            </span>
          </span>
          <span class="slogan__line">
            <span class="slogan__in">
              <Twill class="slogan__num" text="1" tone="dark" enter delay="0.35s" countTo="1" />
              <span class="slogan__word">propósito.</span>
            </span>
          </span>
        </span>
      </h1>

      <p class="lead hero__lead-text">
        A gente estampa camisetas, ecobags, bolsas e copos do seu jeito. Escreva um nome e um número,
        veja na peça e peça o orçamento pelo WhatsApp.
      </p>

      <div class="hero__cta">
        <a class="btn btn--primary" href="#pedido" data-wa-link>
          <Icon name="chat" />
          <span>Pedir no WhatsApp</span>
        </a>
        <a class="btn btn--ghost" href="#pecas">
          <span>Ver as peças</span>
          <Icon name="arrow-down" />
        </a>
      </div>
      <p class="note hero__sign">Feito pela Yasmin e pelo Gabriel.</p>

      <p class="sr-only" role="status" data-wa-announce></p>
      <div class="wa-status" data-wa-status hidden>
        <p data-wa-status-text></p>
        <button class="btn btn--ghost btn--small" type="button" data-copy-msg>
          <Icon name="copy" />
          <span>Copiar mensagem</span>
        </button>
      </div>
    </div>

    <div class="stage">
      <div class="stage__scroll">
        <div class="stage__tilt">
          <svg class="heart heart--a" viewBox="-80 -70 160 140" aria-hidden="true" focusable="false">
            <path d={heart} />
          </svg>
          <svg class="heart heart--b" viewBox="-80 -70 160 140" aria-hidden="true" focusable="false">
            <path d={heart} />
          </svg>
          <div class="stage__view" data-view data-color="preta">
            <span class="stage__disc" aria-hidden="true"></span>
            {kinds.map((k, i) => (
              <div class:list={['piece-wrap', { 'is-active': i === 0 }]} data-kind={k}>
                <Piece kind={k} live color="preta" name="Seu nome" num="10" />
              </div>
            ))}
          </div>
        </div>
      </div>
      <p class="sr-only" role="status" data-preview-live></p>

      <form class="controls" novalidate aria-label="Monte a sua peça" onsubmit="return false">
        <div class="fields">
          <div class="field field--name">
            <label for="pv-name">Nome</label>
            <input
              id="pv-name"
              name="pv-name"
              type="text"
              maxlength="14"
              autocomplete="off"
              autocapitalize="characters"
              spellcheck="false"
              placeholder="Digite um nome"
            />
          </div>
          <div class="field field--num">
            <label for="pv-num">Número</label>
            <input
              id="pv-num"
              name="pv-num"
              type="text"
              maxlength="4"
              autocomplete="off"
              inputmode="text"
              spellcheck="false"
              placeholder="10"
            />
          </div>
        </div>

        <fieldset class="seg">
          <legend>Peça</legend>
          {products.map((p, i) => (
            <span class="seg__opt">
              <input type="radio" name="pv-piece" id={`pv-piece-${p.key}`} value={p.key} checked={i === 0} />
              <label for={`pv-piece-${p.key}`}>{p.label}</label>
            </span>
          ))}
        </fieldset>

        <div class="colors">
          <fieldset class="seg seg--color">
            <legend>Cor de exemplo</legend>
            {colors.map((c, i) => (
              <span class="seg__opt seg__opt--dot">
                <input type="radio" name="pv-color" id={`pv-color-${c.key}`} value={c.key} checked={i === 0} />
                <label for={`pv-color-${c.key}`} title={c.label}>
                  <i class="dot" style={`--dot:${c.dot}`}></i>
                  <span class="sr-only">{c.label}</span>
                </label>
              </span>
            ))}
          </fieldset>
          <p class="hint">Cores ilustrativas. As opções reais a gente combina com você no WhatsApp.</p>
        </div>
      </form>
    </div>
  </div>

  <a class="hero__cue" href="#camisa" aria-label="Rolar para ver a camisa girar">
    <span class="hero__cue-dot"></span>
    <span class="hero__cue-text">role</span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: calc(100vh - var(--header-h));
    min-height: calc(100svh - var(--header-h));
    display: grid;
    align-items: center;
    padding-block: clamp(1rem, 3vh, 2.5rem) clamp(3.5rem, 8vh, 5.5rem);
    overflow: clip;
  }

  /* furinhos de jersey que acendem perto do cursor */
  .hero__mesh {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background-image: radial-gradient(circle at 50% 50%, rgba(167, 139, 255, 0.95) 1.3px, transparent 2px);
    background-size: 9px 9px;
    -webkit-mask-image: radial-gradient(circle 17rem at var(--mx, 70%) var(--my, 35%), #000 0%, transparent 100%);
    mask-image: radial-gradient(circle 17rem at var(--mx, 70%) var(--my, 35%), #000 0%, transparent 100%);
    opacity: 0.55;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    column-gap: clamp(1.5rem, 4vw, 4.5rem);
    align-items: center;
  }
  .hero__copy {
    display: grid;
    gap: clamp(1rem, 2.4vh, 1.6rem);
    justify-items: start;
    min-width: 0;
  }

  /* slogan: numerais de uniforme + palavras em minúsculas, como o logo */
  .slogan {
    display: grid;
    gap: clamp(0.15rem, 0.8vh, 0.5rem);
    font-size: clamp(2.05rem, 0.4rem + 6.3vw, 4.7rem);
  }
  .slogan__line {
    display: block;
    overflow: hidden;
    padding-block: 0.04em;
  }
  .slogan__in {
    display: flex;
    align-items: center;
    gap: 0.22em;
  }
  .slogan__word {
    font: 800 1em / 1 var(--f-display);
    letter-spacing: -0.045em;
    color: #fff;
    white-space: nowrap;
  }
  .slogan__in :global(.slogan__num) {
    height: 1.12em;
    width: auto;
    flex: none;
  }
  :global(:root:not(.intro-wait)) .slogan__in {
    animation: line-up 0.95s var(--ease-out) backwards;
  }
  :global(:root:not(.intro-wait)) .slogan__line:nth-child(2) .slogan__in {
    animation-delay: 0.12s;
  }
  :global(:root:not(.intro-wait)) .slogan__line:nth-child(3) .slogan__in {
    animation-delay: 0.24s;
  }
  @keyframes line-up {
    from {
      transform: translateY(105%);
    }
  }

  .hero__lead-text {
    max-width: 31rem;
    color: var(--on-dark);
  }
  :global(:root:not(.intro-wait)) .hero__lead-text,
  :global(:root:not(.intro-wait)) .hero__cta,
  :global(:root:not(.intro-wait)) .hero__sign {
    animation: rise 0.9s var(--ease-out) 0.55s backwards;
  }
  :global(:root:not(.intro-wait)) .hero__cta {
    animation-delay: 0.68s;
  }
  :global(:root:not(.intro-wait)) .hero__sign {
    animation-delay: 0.8s;
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .hero__sign {
    font-size: clamp(1.25rem, 1rem + 0.6vw, 1.5rem);
  }

  /* a região viva (sr-only) fica sempre na página; a caixa visível, com o botão, só existe quando aparece */
  .wa-status {
    display: grid;
    gap: 0.75rem;
    padding: 1rem 1.1rem;
    border: 1.5px dashed var(--line-dark);
    border-radius: 14px;
    font-size: 0.95rem;
    max-width: 34rem;
  }
  .wa-status[hidden] {
    display: none;
  }
  .btn--small {
    min-height: 2.75rem;
    padding: 0.5rem 1rem;
    font-size: 0.95rem;
    justify-self: start;
  }

  /* ---------- palco ---------- */
  .stage {
    position: relative;
    display: grid;
    gap: clamp(0.6rem, 1.4vh, 1rem);
    justify-items: center;
    min-width: 0;
  }
  .stage__scroll {
    width: 100%;
    display: grid;
    justify-items: center;
    transform: translate3d(0, calc(var(--hs, 0) * 46px), 0) rotate(calc(var(--hs, 0) * -4deg));
    will-change: transform;
  }
  .stage__tilt {
    position: relative;
    width: min(100%, 27.5rem, 40svh);
    transform-style: preserve-3d;
    transform: perspective(1100px) rotateX(calc(var(--ty, 0) * -12deg)) rotateY(calc(var(--tx, 0) * 16deg));
    will-change: transform;
  }
  .stage__view {
    position: relative;
    width: 100%;
    aspect-ratio: 400 / 420;
    transform: translateZ(0);
  }
  /* o disco da marca por trás da peça: a camisa preta precisa de um chão que a destaque */
  .stage__disc {
    position: absolute;
    left: 4%;
    top: 3%;
    width: 92%;
    aspect-ratio: 1;
    border-radius: 50%;
    background-color: var(--purple);
    background-image: radial-gradient(circle at 50% 50%, rgba(11, 11, 15, 0.14) 1.1px, transparent 1.7px);
    background-size: 9px 9px;
    transition: background-color 0.5s var(--ease-out);
    transform: translateZ(-30px);
  }
  :global(:root:not(.intro-wait)) .stage__disc {
    animation: disc-in 1.1s var(--ease-out) 0.1s backwards;
  }
  .stage__view[data-color='roxa'] .stage__disc {
    background-color: var(--ink-3);
  }
  @keyframes disc-in {
    from {
      clip-path: circle(0% at 50% 50%);
      opacity: 0;
    }
    to {
      clip-path: circle(75% at 50% 50%);
    }
  }
  .piece-wrap {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: translateY(10px) scale(0.97) translateZ(24px);
    transition:
      opacity 0.4s var(--ease-out),
      transform 0.55s var(--ease-out);
    pointer-events: none;
  }
  .piece-wrap.is-active {
    opacity: 1;
    transform: translateZ(24px);
    animation: bob 7s ease-in-out infinite;
  }
  @keyframes bob {
    50% {
      transform: translate3d(0, -7px, 24px);
    }
  }
  .piece-wrap :global(svg) {
    width: 100%;
    height: 100%;
  }

  /* dois corações flutuando, com profundidade própria */
  .heart {
    position: absolute;
    width: 22%;
    height: auto;
    z-index: 2;
    pointer-events: none;
  }
  .heart path {
    stroke: none;
  }
  .heart--a {
    left: -4%;
    top: 9%;
    transform: translate3d(calc(var(--tx, 0) * -44px), calc(var(--ty, 0) * -30px), 70px) rotate(-12deg);
  }
  .heart--a path {
    fill: #fff;
  }
  .heart--b {
    right: -3%;
    bottom: 22%;
    width: 17%;
    transform: translate3d(calc(var(--tx, 0) * 54px), calc(var(--ty, 0) * 36px), 90px) rotate(11deg);
  }
  .heart--b path {
    fill: var(--purple-hi);
  }
  :global(:root:not(.intro-wait)) .heart {
    animation: heart-in 0.9s var(--ease-out) 0.9s backwards;
  }
  @keyframes heart-in {
    from {
      opacity: 0;
      scale: 0.4;
    }
  }

  /* ---------- painel de controles ---------- */
  .controls {
    display: grid;
    gap: 0.8rem;
    width: min(100%, 31rem);
    padding: clamp(0.85rem, 2.4vw, 1.1rem);
    background: var(--ink-2);
    border: 1.5px dashed var(--line-dark);
    border-radius: 22px;
  }
  :global(:root:not(.intro-wait)) .controls {
    animation: rise 0.9s var(--ease-out) 0.75s backwards;
  }
  .fields {
    display: grid;
    grid-template-columns: minmax(0, 2.2fr) minmax(0, 1fr);
    gap: 0.6rem;
  }
  .field label {
    display: block;
    margin-bottom: 0.3rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--on-dark-soft);
  }
  .field input {
    width: 100%;
    min-height: 3rem;
    padding: 0.55rem 0.85rem;
    background: var(--ink);
    color: #fff;
    border: 1.5px solid var(--line-dark);
    border-radius: 14px;
    font: 600 1rem/1.2 var(--f-text);
    text-transform: uppercase;
    transition: border-color 0.2s;
  }
  .field input::placeholder {
    color: rgba(255, 255, 255, 0.5);
    text-transform: none;
    font-weight: 500;
  }
  .field input:hover {
    border-color: rgba(255, 255, 255, 0.45);
  }
  .field input:focus {
    border-color: var(--purple-hi);
  }

  .seg {
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .seg legend {
    float: left;
    width: 100%;
    padding: 0;
    margin-bottom: 0.4rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--on-dark-soft);
  }
  .seg__opt {
    position: relative;
    flex: 1 1 auto;
  }
  .seg__opt input {
    position: absolute;
    inset: 0;
    opacity: 0;
    margin: 0;
    cursor: pointer;
  }
  .seg__opt label {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-height: 2.75rem;
    padding: 0.5rem 0.8rem;
    border: 1.5px dashed var(--line-dark);
    border-radius: 999px;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--on-dark);
    cursor: pointer;
    transition:
      background-color 0.2s,
      color 0.2s,
      border-color 0.2s;
  }
  .seg__opt input:hover + label {
    border-color: rgba(255, 255, 255, 0.5);
  }
  .seg__opt input:checked + label {
    background: #fff;
    color: var(--ink);
    border: 1.5px solid #fff;
  }
  .seg__opt input:focus-visible + label {
    outline: 3px solid #fff;
    outline-offset: 3px;
    box-shadow: 0 0 0 6px var(--purple);
  }
  .colors {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }
  .seg--color {
    flex: none;
    flex-wrap: nowrap;
  }
  .seg--color legend {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }
  .seg__opt--dot {
    flex: none;
  }
  .seg__opt--dot label {
    width: 2.75rem;
    padding: 0;
  }
  .seg__opt--dot input:checked + label {
    background: transparent;
    border: 1.5px solid #fff;
    box-shadow: 0 0 0 2px var(--ink-2), 0 0 0 3.5px rgba(255, 255, 255, 0.7);
  }
  .dot {
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 50%;
    background: var(--dot);
    box-shadow: inset 0 0 0 1.5px rgba(128, 128, 140, 0.7);
    flex: none;
  }
  .hint {
    font-size: 0.8rem;
    line-height: 1.45;
    color: var(--on-dark-soft);
  }

  /* convite para rolar */
  .hero__cue {
    position: absolute;
    left: 50%;
    bottom: clamp(0.6rem, 2vh, 1.2rem);
    translate: -50% 0;
    display: grid;
    justify-items: center;
    gap: 0.35rem;
    min-width: 2.75rem;
    min-height: 2.75rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--on-dark-soft);
  }
  .hero__cue-dot {
    width: 1.35rem;
    height: 2.1rem;
    border: 1.5px solid currentColor;
    border-radius: 999px;
    position: relative;
  }
  .hero__cue-dot::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 0.4rem;
    width: 0.25rem;
    height: 0.45rem;
    margin-left: -0.125rem;
    border-radius: 999px;
    background: currentColor;
    animation: cue 1.8s var(--ease-quart) infinite;
  }
  @keyframes cue {
    0% {
      opacity: 0;
      transform: translateY(0);
    }
    30% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateY(0.8rem);
    }
  }

  /* ---------- telas menores ---------- */
  @media (max-width: 62rem) {
    .hero {
      min-height: 0;
      padding-block: clamp(1rem, 3vw, 2rem) clamp(4.5rem, 12vw, 6rem);
    }
    .hero__grid {
      grid-template-columns: minmax(0, 1fr);
      row-gap: clamp(1.5rem, 5vw, 2.5rem);
    }
    .stage__tilt {
      width: min(100%, 25rem, 52svh);
    }
    /* no celular: slogan, depois a camisa e os controles, depois o texto e os botões */
    .hero__copy {
      display: contents;
    }
    .hero__title {
      order: 1;
    }
    .stage {
      order: 2;
    }
    .hero__lead-text {
      order: 3;
    }
    .hero__cta {
      order: 4;
    }
    .hero__sign {
      order: 5;
    }
    .wa-status {
      order: 6;
    }
    .hero__title,
    .hero__lead-text,
    .hero__cta,
    .hero__sign,
    .wa-status {
      justify-self: start;
    }
    .slogan {
      font-size: clamp(2.05rem, 0.4rem + 8.4vw, 4rem);
    }
    .hero__cue {
      display: none;
    }
    .heart--a {
      left: 1%;
    }
    .heart--b {
      right: 1%;
    }
  }
  @media (max-width: 30rem) {
    .seg {
      gap: 0.35rem;
    }
    .seg__opt label {
      padding-inline: 0.6rem;
      font-size: 0.88rem;
    }
    .controls {
      border-radius: 18px;
    }
  }
  @media (max-height: 40rem) and (min-width: 62.01rem) {
    .hero__cue {
      display: none;
    }
  }
</style>
