---
import Twill from './Twill.astro';
import Piece from './Piece.astro';
import Icon from './Icon.astro';

// o logo "duo" em caminhos, centrado na origem; as cores vêm do tom da peça (lg-d / lg-u)
const logo = {
  d: 'M122 40H150V203H122V196.73A53 53 0 1 1 122 103.27ZM72 150A25 28 0 1 1 122 150A25 28 0 1 1 72 150Z',
  u: 'M177 112V161A54 54 0 0 0 285 161V112H257V161A26 29 0 0 1 205 161V112Z',
  o: 'M304 150A53 53 0 1 1 410 150A53 53 0 1 1 304 150ZM332 150A25 28 0 1 1 382 150A25 28 0 1 1 332 150Z',
};
---

<section class="hero ground-ink" id="topo" aria-labelledby="hero-title" data-hero data-tilt>
  <div class="hero__mesh" aria-hidden="true"></div>

  <div class="container hero__grid">
    <div class="hero__copy">
      <h1 class="hero__title" id="hero-title">
        <span class="sr-only">2 corações, 2 objetivos, 1 propósito</span>
        <span class="slogan" aria-hidden="true">
          <span class="slogan__line">
            <span class="slogan__in">
              <Twill class="slogan__num" text="2" tone="dark" enter delay="0.05s" countTo="2" />
              <span class="slogan__word">corações,</span>
            </span>
          </span>
          <span class="slogan__line">
            <span class="slogan__in">
              <Twill class="slogan__num" text="2" tone="dark" enter delay="0.2s" countTo="2" />
              <span class="slogan__word">objetivos,</span>
            </span>
          </span>
          <span class="slogan__line">
            <span class="slogan__in">
              <Twill class="slogan__num" text="1" tone="dark" enter delay="0.35s" countTo="1" />
              <span class="slogan__word">propósito.</span>
            </span>
          </span>
        </span>
      </h1>

      <p class="lead hero__lead-text">
        Camisetas, ecobags, bolsas e copos personalizados, feitos por Yasmin e Gabriel.
      </p>

      <div class="hero__cta">
        <a class="btn btn--primary" href="#pedido" data-wa-link>
          <Icon name="chat" />
          <span>Pedir no WhatsApp</span>
        </a>
        <a class="btn btn--ghost" href="#monte">
          <span>Montar a minha</span>
        </a>
      </div>
    </div>

    <div class="hero__art" aria-hidden="true">
      <span class="hero__disc"></span>

      <div class="hero__piece hero__piece--shirt" style="--z:60;--r:0deg;--i:0">
        <Piece kind="camiseta" view="front" color="preta">
          <g transform="scale(.27) translate(-226 -127.5)">
            <path class="lg-d" fill-rule="evenodd" d={logo.d} />
            <path class="lg-u" d={logo.u} />
            <path class="lg-d" fill-rule="evenodd" d={logo.o} />
          </g>
        </Piece>
      </div>
      <div class="hero__piece hero__piece--tote" style="--z:110;--r:-9deg;--i:1">
        <Piece kind="ecobag" color="branca">
          <g transform="scale(.3) translate(-226 -127.5)">
            <path class="lg-d" fill-rule="evenodd" d={logo.d} />
            <path class="lg-u" d={logo.u} />
            <path class="lg-d" fill-rule="evenodd" d={logo.o} />
          </g>
        </Piece>
      </div>
      <div class="hero__piece hero__piece--bag" style="--z:80;--r:8deg;--i:2">
        <Piece kind="bolsa" color="preta">
          <g transform="scale(.3) translate(-226 -127.5)">
            <path class="lg-d" fill-rule="evenodd" d={logo.d} />
            <path class="lg-u" d={logo.u} />
            <path class="lg-d" fill-rule="evenodd" d={logo.o} />
          </g>
        </Piece>
      </div>
      <div class="hero__piece hero__piece--cup" style="--z:130;--r:-12deg;--i:3">
        <Piece kind="copo" color="branca">
          <g transform="scale(.26) translate(-226 -127.5)">
            <path class="lg-d" fill-rule="evenodd" d={logo.d} />
            <path class="lg-u" d={logo.u} />
            <path class="lg-d" fill-rule="evenodd" d={logo.o} />
          </g>
        </Piece>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: calc(100vh - var(--header-h));
    min-height: calc(100svh - var(--header-h));
    display: grid;
    align-items: center;
    padding-block: clamp(1.5rem, 5vh, 3.5rem);
    overflow: clip;
  }

  /* furinhos de jersey que acendem perto do cursor */
  .hero__mesh {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background-image: radial-gradient(circle at 50% 50%, rgba(167, 139, 255, 0.95) 1.3px, transparent 2px);
    background-size: 9px 9px;
    -webkit-mask-image: radial-gradient(circle 17rem at var(--mx, 72%) var(--my, 40%), #000 0%, transparent 100%);
    mask-image: radial-gradient(circle 17rem at var(--mx, 72%) var(--my, 40%), #000 0%, transparent 100%);
    opacity: 0.55;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    column-gap: clamp(1.5rem, 4vw, 4.5rem);
    align-items: center;
  }
  .hero__copy {
    display: grid;
    gap: clamp(1.1rem, 3vh, 1.8rem);
    justify-items: start;
    min-width: 0;
  }

  /* slogan: numerais de uniforme + palavras em minúsculas, como o logo */
  .slogan {
    display: grid;
    gap: clamp(0.15rem, 0.8vh, 0.5rem);
    font-size: clamp(2.05rem, 0.4rem + 6.3vw, 4.7rem);
  }
  .slogan__line {
    display: block;
    overflow: hidden;
    padding-block: 0.04em;
  }
  .slogan__in {
    display: flex;
    align-items: center;
    gap: 0.22em;
  }
  .slogan__word {
    font: 800 1em / 1 var(--f-display);
    letter-spacing: -0.045em;
    color: #fff;
    white-space: nowrap;
  }
  .slogan__in :global(.slogan__num) {
    height: 1.12em;
    width: auto;
    flex: none;
  }
  :global(:root:not(.intro-wait)) .slogan__in {
    animation: line-up 0.95s var(--ease-out) backwards;
  }
  :global(:root:not(.intro-wait)) .slogan__line:nth-child(2) .slogan__in {
    animation-delay: 0.12s;
  }
  :global(:root:not(.intro-wait)) .slogan__line:nth-child(3) .slogan__in {
    animation-delay: 0.24s;
  }
  @keyframes line-up {
    from {
      transform: translateY(105%);
    }
  }

  .hero__lead-text {
    max-width: 27rem;
    color: var(--on-dark);
  }
  :global(:root:not(.intro-wait)) .hero__lead-text,
  :global(:root:not(.intro-wait)) .hero__cta {
    animation: rise 0.9s var(--ease-out) 0.55s backwards;
  }
  :global(:root:not(.intro-wait)) .hero__cta {
    animation-delay: 0.7s;
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* ---------- as peças que a DUO faz, soltas sobre o disco ---------- */
  .hero__art {
    position: relative;
    width: min(100%, 34rem, 78svh);
    aspect-ratio: 1;
    margin-inline: auto;
    transform: translate3d(0, calc(var(--hs, 0) * 40px), 0);
    will-change: transform;
  }
  .hero__disc {
    position: absolute;
    inset: 8%;
    border-radius: 50%;
    background-color: var(--purple);
    background-image: radial-gradient(circle at 50% 50%, rgba(11, 11, 15, 0.14) 1.1px, transparent 1.7px);
    background-size: 9px 9px;
    transform: translate3d(calc(var(--tx, 0) * -16px), calc(var(--ty, 0) * -11px), 0);
  }
  :global(:root:not(.intro-wait)) .hero__disc {
    animation: disc-in 1.1s var(--ease-out) 0.1s backwards;
  }
  @keyframes disc-in {
    from {
      clip-path: circle(0% at 50% 50%);
      opacity: 0;
    }
    to {
      clip-path: circle(75% at 50% 50%);
    }
  }
  .hero__piece {
    position: absolute;
    transform: translate3d(calc(var(--tx, 0) * var(--z) * -1px), calc(var(--ty, 0) * var(--z) * -0.6px), 0) rotate(var(--r));
    will-change: transform;
    /* flutua sem brigar com o transform do mouse: usa a propriedade translate */
    animation: float 6.5s ease-in-out calc(var(--i) * -1.4s) infinite;
  }
  .hero__piece :global(svg) {
    width: 100%;
    height: auto;
  }
  @keyframes float {
    50% {
      translate: 0 -0.7rem;
    }
  }
  :global(:root:not(.intro-wait)) .hero__piece {
    animation:
      float 6.5s ease-in-out calc(var(--i) * -1.4s) infinite,
      piece-in 1s var(--ease-out) calc(0.35s + var(--i) * 0.14s) backwards;
  }
  @keyframes piece-in {
    from {
      opacity: 0;
      scale: 0.82;
    }
  }
  .hero__piece--shirt {
    left: 17%;
    top: 14%;
    width: 66%;
    z-index: 2;
  }
  .hero__piece--tote {
    left: 0;
    top: 3%;
    width: 30%;
    z-index: 3;
  }
  .hero__piece--bag {
    right: 0;
    top: 46%;
    width: 33%;
    z-index: 3;
  }
  .hero__piece--cup {
    left: 5%;
    bottom: 3%;
    width: 21%;
    z-index: 3;
  }

  /* ---------- telas menores ---------- */
  @media (max-width: 62rem) {
    .hero {
      min-height: 0;
      padding-block: clamp(1rem, 3vw, 2rem) clamp(4.5rem, 12vw, 6rem);
    }
    .hero__grid {
      grid-template-columns: minmax(0, 1fr);
      row-gap: clamp(1.25rem, 4vw, 2.25rem);
    }
    /* no celular: slogan, depois as peças, depois o texto e os botões */
    .hero__copy {
      display: contents;
    }
    .hero__title {
      order: 1;
    }
    .hero__art {
      order: 2;
      width: min(100%, 24rem, 52svh);
    }
    .hero__lead-text {
      order: 3;
    }
    .hero__cta {
      order: 4;
    }
    .hero__title,
    .hero__lead-text,
    .hero__cta {
      justify-self: start;
    }
    .slogan {
      font-size: clamp(2.05rem, 0.4rem + 8.4vw, 4rem);
    }
  }
</style>
