---
import Piece from './Piece.astro';
import Twill from './Twill.astro';
import Icon from './Icon.astro';
import { products } from '../config/site';

// Cores e escala do logo estampado em cada peça de exemplo.
const show = {
  camiseta: { color: 'preta', scale: 0.3, tone: 'dark', drop: 'clamp(1rem, 2vw, 2rem)', tilt: '-3deg' },
  ecobag: { color: 'branca', scale: 0.3, tone: 'light', drop: 'clamp(3.5rem, 7vw, 6rem)', tilt: '2.5deg' },
  bolsa: { color: 'roxa', scale: 0.3, tone: 'purple', drop: 'clamp(2rem, 4vw, 3.5rem)', tilt: '-2deg' },
  copo: { color: 'branca', scale: 0.26, tone: 'light', drop: 'clamp(5rem, 10vw, 8.5rem)', tilt: '3deg' },
} as const;

// Logo em caminhos, centrado na origem (ink bbox 44..408 x 40..215 no sistema original).
const D = {
  light: {
    d: 'M120 40H150V203H120V197.75A53 53 0 1 1 120 102.25ZM74 150A23 26 0 1 1 120 150A23 26 0 1 1 74 150Z',
    u: 'M176 112V161A54 54 0 0 0 284 161V112H254V161A24 27 0 0 1 206 161V112Z',
    o: 'M302 150A53 53 0 1 1 408 150A53 53 0 1 1 302 150ZM332 150A23 26 0 1 1 378 150A23 26 0 1 1 332 150Z',
    fill: '#0B0B0F',
    ufill: '#7A3CFF',
  },
  dark: {
    d: 'M122 40H150V203H122V196.73A53 53 0 1 1 122 103.27ZM72 150A25 28 0 1 1 122 150A25 28 0 1 1 72 150Z',
    u: 'M177 112V161A54 54 0 0 0 285 161V112H257V161A26 29 0 0 1 205 161V112Z',
    o: 'M304 150A53 53 0 1 1 410 150A53 53 0 1 1 304 150ZM332 150A25 28 0 1 1 382 150A25 28 0 1 1 332 150Z',
    fill: '#FFFFFF',
    ufill: '#8F5CFF',
  },
};
const logoFor = (tone: string) => {
  if (tone === 'light') return D.light;
  if (tone === 'purple') return { ...D.dark, ufill: '#0B0B0F' };
  return D.dark;
};
---

<section class="vestiario ground-ink section" id="pecas" aria-labelledby="pecas-title">
  <div class="container">
    <div class="vestiario__head reveal">
      <h2 class="h2" id="pecas-title">O que a gente estampa</h2>
      <p class="lead">
        Quatro peças, o mesmo cuidado. Escolha uma, que ela já vai lá para cima para você montar com o seu nome.
      </p>
    </div>

    <ul class="rail">
      {products.map((p) => {
        const s = show[p.key];
        const logo = logoFor(s.tone);
        return (
          <li class="item reveal" style={`--drop:${s.drop};--tilt:${s.tilt}`}>
            <Twill
              class="item__num"
              text={p.number}
              tone="ghost"
              vb="0 0 160 112"
              x={80}
              decorative
            />
            <div class="item__art">
              <Piece kind={p.key} color={s.color} title={`${p.label} com o logo da DUO estampado`}>
                <g transform={`scale(${s.scale}) translate(-226 -127.5)`}>
                  <path fill={logo.fill} fill-rule="evenodd" d={logo.d} />
                  <path fill={logo.ufill} d={logo.u} />
                  <path fill={logo.fill} fill-rule="evenodd" d={logo.o} />
                </g>
              </Piece>
            </div>
            <h3 class="item__title">{p.label}</h3>
            <p class="item__line">{p.line}</p>
            <button class="item__pick" type="button" data-pick={p.key}>
              <span>{p.pick}</span>
              <Icon name="arrow-right" />
            </button>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .vestiario__head {
    display: grid;
    gap: 1.1rem;
    max-width: 44rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .rail {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    column-gap: clamp(0.75rem, 2vw, 2rem);
    align-items: start;
  }
  /* a barra do cabide: uma costura reta de ponta a ponta */
  .rail::before {
    content: '';
    position: absolute;
    left: -0.5rem;
    right: -0.5rem;
    top: 0;
    border-top: 2px dashed rgba(255, 255, 255, 0.34);
  }
  .item {
    position: relative;
    display: grid;
    gap: 0.5rem;
    padding-top: var(--drop);
    transform-origin: 50% 0;
  }
  /* o fio que prende a peça na barra */
  .item::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    height: var(--drop);
    border-left: 2px dashed rgba(255, 255, 255, 0.34);
  }
  .item :global(.item__num) {
    position: absolute;
    right: -4%;
    top: calc(var(--drop) + 8%);
    width: 78%;
    height: auto;
    z-index: 0;
    pointer-events: none;
  }
  .item__art {
    position: relative;
    z-index: 1;
    transition: transform 0.6s var(--ease-out);
  }
  .item:hover .item__art,
  .item:focus-within .item__art {
    transform: rotate(var(--tilt)) translateY(-4px);
  }
  .item__art :global(svg) {
    width: 100%;
    height: auto;
  }
  .item__title {
    position: relative;
    z-index: 1;
    margin-top: 0.4rem;
    font: 900 clamp(1.9rem, 3vw, 2.5rem) / 0.95 var(--f-display);
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: #fff;
  }
  .item__line {
    position: relative;
    z-index: 1;
    color: var(--on-dark);
    max-width: 17rem;
  }
  .item__pick {
    position: relative;
    z-index: 1;
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.4rem 0;
    background: none;
    border: 0;
    color: #fff;
    font: 700 1rem/1.2 var(--f-text);
    cursor: pointer;
    text-decoration: underline dashed;
    text-decoration-color: var(--purple-hi);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.35em;
  }
  .item__pick :global(svg) {
    width: 1.15rem;
    height: 1.15rem;
    transition: transform 0.25s var(--ease-out);
  }
  .item__pick:hover :global(svg) {
    transform: translateX(4px);
  }

  /* peças penduradas: entram balançando, como quem acabou de ser colocado no cabide */
  :global(.js) .item.reveal {
    transform: rotate(calc(var(--tilt) * 1.6)) translateY(12px);
  }
  :global(.js) .item.reveal.in {
    transform: none;
    transition:
      opacity 0.6s var(--ease-out),
      transform 1.1s var(--ease-out);
    transition-delay: var(--d, 0s);
  }

  @media (max-width: 52rem) {
    .rail {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 2.5rem;
    }
    .rail::before {
      display: none;
    }
    .item {
      padding-top: 1.5rem;
    }
    .item::before {
      height: 1.5rem;
    }
    .item :global(.item__num) {
      top: 12%;
    }
  }
  @media (max-width: 30rem) {
    .rail {
      column-gap: 1.25rem;
    }
    .item__pick :global(svg) {
      display: none;
    }
    .item__line {
      font-size: 0.97rem;
    }
  }
</style>
