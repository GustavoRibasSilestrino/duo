---
const items = ['Camisetas', 'Ecobags', 'Bolsas', 'Copos'];
const run = [...items, ...items, ...items];
---

<div class="marquee ground-purple" data-marquee>
  <div class="marquee__track" aria-hidden="true">
    {[0, 1].map(() => (
      <ul class="marquee__list">
        {run.map((t) => (
          <li>
            <span>{t}</span>
            <svg viewBox="0 0 24 24" focusable="false">
              <path d="M12 21C3 14.5 1 9.5 3.6 6.4 5.9 3.7 9.6 4.4 12 7.2c2.4-2.8 6.1-3.5 8.4-.8C23 9.5 21 14.5 12 21Z" />
            </svg>
          </li>
        ))}
      </ul>
    ))}
  </div>
  <!-- quem não quer a faixa em movimento pausa aqui (WCAG 2.2.2) -->
  <button class="marquee__pause" type="button" aria-pressed="false" data-marquee-pause>
    <span class="sr-only" data-marquee-label>Pausar a faixa em movimento</span>
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path class="i-pause" d="M8 5v14M16 5v14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
      <path class="i-play" d="M8 5.5v13l11-6.5Z" fill="currentColor" />
    </svg>
  </button>
</div>

<style>
  .marquee {
    position: relative;
    overflow: hidden;
    padding-block: 0.9rem;
    background-image: radial-gradient(circle at 50% 50%, rgba(11, 11, 15, 0.12) 1.1px, transparent 1.7px);
    background-size: 9px 9px;
  }
  .marquee__track {
    display: flex;
    width: max-content;
    animation: slide 38s linear infinite;
  }
  .marquee:hover .marquee__track,
  .marquee.is-paused .marquee__track {
    animation-play-state: paused;
  }
  .marquee__list {
    display: flex;
    flex: none;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .marquee__list li {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    padding-right: 1.4rem;
    font: 900 clamp(2rem, 4.4vw, 3.4rem) / 1 var(--f-display);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--ink);
    white-space: nowrap;
  }
  .marquee__list svg {
    width: 1.5rem;
    height: 1.5rem;
    fill: #fff;
    flex: none;
  }
  .marquee__pause {
    position: absolute;
    top: 50%;
    right: var(--gutter);
    transform: translateY(-50%);
    width: 2.75rem;
    height: 2.75rem;
    display: grid;
    place-items: center;
    padding: 0;
    background: var(--ink);
    color: #fff;
    border: 0;
    border-radius: 4px;
    cursor: pointer;
  }
  .marquee__pause svg {
    width: 1.3rem;
    height: 1.3rem;
  }
  .marquee__pause .i-play,
  .marquee__pause[aria-pressed='true'] .i-pause {
    display: none;
  }
  .marquee__pause[aria-pressed='true'] .i-play {
    display: block;
  }
  @keyframes slide {
    to {
      transform: translateX(-50%);
    }
  }
</style>

<script>
  const m = document.querySelector<HTMLElement>('[data-marquee]');
  const btn = m?.querySelector<HTMLButtonElement>('[data-marquee-pause]');
  const label = m?.querySelector<HTMLElement>('[data-marquee-label]');
  btn?.addEventListener('click', () => {
    const paused = m!.classList.toggle('is-paused');
    btn.setAttribute('aria-pressed', String(paused));
    if (label) label.textContent = paused ? 'Retomar a faixa em movimento' : 'Pausar a faixa em movimento';
  });
</script>
