---
/** Ícones desenhados à mão, mesmo traço (1.8) e pontas arredondadas. */
interface Props {
  name: 'chat' | 'instagram' | 'copy' | 'arrow-down' | 'arrow-right' | 'menu' | 'close' | 'check';
  class?: string;
}
const { name, class: cls = '' } = Astro.props;
---

<svg
  class={cls}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'chat' && (
    <>
      <path d="M12 3.4a8.6 8.6 0 0 0-7.4 13L3.4 20.6l4.3-1.1A8.6 8.6 0 1 0 12 3.4Z" />
      <path d="M9.1 8.5c.2 2.5 2.7 5 5.3 5.3l1.3-1.3-1.9-1-1 .8c-.8-.4-1.7-1.3-2.1-2.1l.8-1-1-1.9Z" />
    </>
  )}
  {name === 'instagram' && (
    <>
      <rect x="3.5" y="3.5" width="17" height="17" rx="5" />
      <circle cx="12" cy="12" r="3.9" />
      <circle cx="17.2" cy="6.8" r=".6" fill="currentColor" />
    </>
  )}
  {name === 'copy' && (
    <>
      <rect x="8.5" y="8.5" width="11.5" height="11.5" rx="2.5" />
      <path d="M15.5 8.5V6A2.5 2.5 0 0 0 13 3.5H6A2.5 2.5 0 0 0 3.5 6v7A2.5 2.5 0 0 0 6 15.5h2.5" />
    </>
  )}
  {name === 'arrow-down' && <path d="M12 4.5v15m0 0-6-6m6 6 6-6" />}
  {name === 'arrow-right' && <path d="M4.5 12h15m0 0-6-6m6 6-6 6" />}
  {name === 'menu' && <path d="M4 7.5h16M4 12h16M4 16.5h16" />}
  {name === 'close' && <path d="m6 6 12 12M18 6 6 18" />}
  {name === 'check' && <path d="m5 12.5 4.5 4.5L19 7.5" />}
</svg>
